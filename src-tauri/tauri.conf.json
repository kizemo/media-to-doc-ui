{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "media-to-doc",
  "version": "1.5.0",
  "identifier": "com.duanyi.mediatodoc",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "media-to-doc",
        "width": 1024,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "F:/soft/00selfmade/media-to-doc/src/media_to_doc/data/long_doc_skill/**/*"
    ],
    "windows": {
      "nsis": {
        "template": "./nsis/installer.nsi"
      }
    }
  }
}